GOOGLE_API_KEY=your_google_api_key_here
MISTRALAI_API_KEY=your_mistralai_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# MongoDB connection string (required for auth). Example for local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/ai-battle-arena

# Long random secret for signing JWTs (required). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_secret_here
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
